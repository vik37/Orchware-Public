{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId",
      "WithEnvironmentUserName",
      "WithSpan"
    ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "MSSQLDbConnection": "Server=tcp:127.0.0.1,1433;;Database=Frontoffice_DemoDb;User Id=sa;Password=Test123#;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "RedisConnection": {
    "RedisPort": "localhost:6379",
    "RedisInstance": "orchware-pub"
  },
  "OpenTelemetry": {
    "OtlpExporter": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc"
    }
  },
  "Keycloak": {
    "AuthorizationUri": "http://localhost:8080/realms/orchware-dev/protocol/openid-connect/auth",
    "TokenUrl": "http://localhost:8080/realms/orchware-dev/protocol/openid-connect/token"
  },
  "Authentication": {
    "Audience": "account",
    "MetadataAudience": "http://localhost:8080/realms/orchware-dev/.well-known/openid-configuration",
    "Issuer": "http://localhost:8080/realms/orchware-dev",
    "ClientId": "orchware-frontoffice-dev"
  },
  "RabbitMQSettings": {
    "Host": "localhost",
    "VHost": "/",
    "Port": "5672",
    "Username": "admin",
    "Password": "admin"
  }
}