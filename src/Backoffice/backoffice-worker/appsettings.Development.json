{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId",
      "WithEnvironmentUserName",
      "WithSpan"
    ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "OpenTelemetry": {
    "OtlpExporter": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc"
    }
  },
  "ConnectionStrings": {
    "MSSQLDbConnection": "Server=tcp:127.0.0.1,1433;Database=BackOffice_DemoDb;User Id=sa;Password=Test123#;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "CosmosDBSettings": {
    "Endpoint": "[COSMOS_ENDPOINT]",
    "Secret": "[COSMOS_SECRET]",
    "Database": "orchwaredb"
  }
}
