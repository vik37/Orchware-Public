{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId",
      "WithEnvironmentUserName",
      "WithSpan"
    ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "OpenTelemetry": {
    "OtlpExporter": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc"
    }
  },
  "ConnectionStrings": {
    "MSSQLDbConnection": "Server=tcp:127.0.0.1,1433;Initial Catalog=Orchware_NotificationDb;User Id=sa;Password=Test123#;TrustServerCertificate=True;"
  },
  "EmailConfig": {
    "Host": "smtp.fastmail.com",
    "Port": 587,
    "Username": "[SENDER_EMAIL]",
    "Password": "[EMAIL-Password]",
    "From": "Viktor Zafirovski <billing@viktor-showcase.dev>"
  },
  "Keycloak": {
    "AuthorizationUri": "http://localhost:8080/realms/orchware-dev/protocol/openid-connect/auth",
    "TokenUrl": "http://localhost:8080/realms/orchware-dev/protocol/openid-connect/token"
  },
  "Authentication": {
    "Audience": "account",
    "MetadataAudience": "http://localhost:8080/realms/orchware-dev/.well-known/openid-configuration",
    "Issuer": "http://localhost:8080/realms/orchware-dev",
    "ClientId": "orchware-notifications-dev"
  },
  "RabbitMQSettings": {
    "Host": "localhost",
    "VHost": "/",
    "Port": "5672",
    "Username": "admin",
    "Password": "admin"
  },
  "CosmosDBSettings": {
    "Endpoint": "[COSMOS_ENDPOINT]",
    "Secret": "[COSMOS_SECRET]",
    "Database": "orchwaredb"
  },
  "StorageConnectionString": "[STORAGE_KEY]"
}
